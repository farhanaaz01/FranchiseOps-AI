# ==============================================================================
# FranchiseOps AI — Frontend Client Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` or `.env.local` inside the frontend/ directory:
#    `cp .env.example .env.local`
# 2. NOTE: In Vite, only variables prefixed with `VITE_` are exposed to client code.
# 3. SECURITY WARNING: NEVER put private secrets, private API keys, or database 
#    passwords here, as anything in frontend code is bundled and publicly visible in browsers!
# ==============================================================================

# Backend FastAPI Gateway URL
VITE_API_BASE_URL=http://localhost:8000
